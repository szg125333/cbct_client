    <property name="title">
     <string>窗口</string>
    </property>
    <addaction name="actionToggleLeftPanel"/>
   </widget>
   <!-- 帮助：关于 -->
   <widget class="QMenu" name="menuHelp">
    <property name="title">
     <string>帮助</string>
    </property>
    <addaction name="actionAbout"/>
   </widget>
   <addaction name="menuFile"/>
