  <!--
    菜单栏：五个顶级菜单 + 一级功能 QAction（移植 DicomImageStudy 第一阶段接线）。
    objectName：menuFile menuEdit menuView menuWindow menuHelp
  -->
  <widget class="QMenuBar" name="menubar">
   <!-- 文件：打开 DICOM 目录/文件、退出 -->
   <widget class="QMenu" name="menuFile">
    <property name="title">
     <string>文件</string>
    </property>
    <addaction name="actionOpenDicomDir"/>
    <addaction name="actionOpenDicomFiles"/>
    <addaction name="actionOpenRtStruct"/>
    <addaction name="actionOpenSecondary"/>
    <addaction name="separator"/>
    <addaction name="actionExit"/>
   </widget>
   <!-- 编辑：测量模式 + 清除标注 -->
   <widget class="QMenu" name="menuEdit">
    <property name="title">
     <string>编辑</string>
    </property>
    <addaction name="actionModeDistance"/>
    <addaction name="actionModeAngle"/>
    <addaction name="actionModeRectRoi"/>
    <addaction name="actionModeFreehandRoi"/>
    <addaction name="separator"/>
    <addaction name="actionClearMeasurements"/>
   </widget>
   <!-- 视图：页面切换、重置、交互模式 -->
   <widget class="QMenu" name="menuView">
    <property name="title">
     <string>视图</string>
    </property>
    <addaction name="actionShowThreeView"/>
    <addaction name="actionShowAcquisition"/>
    <addaction name="separator"/>
    <addaction name="actionResetViews"/>
    <addaction name="actionContourList"/>
    <addaction name="actionBlendRatio"/>
    <addaction name="separator"/>
    <addaction name="actionModeNormal"/>
    <addaction name="actionModePan"/>
